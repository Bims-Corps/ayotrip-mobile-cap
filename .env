# ==========================================
# AyoTrip Staging Environment (Mobile App)
# Reference: ayotrip-web-tanstart/.env
# ==========================================

# Backend API & WebSocket Endpoint
VITE_API_ENDPOINT=https://api-ayotrip.bmstudio.my.id
VITE_API_URL=https://api-ayotrip.bmstudio.my.id
VITE_WS_ENDPOINT=wss://api-ayotrip.bmstudio.my.id/socket

# Auth Token & Session Expiration
VITE_ACCESS_TOKEN_EXPIRES_HOURS=1
VITE_REFRESH_TOKEN_EXPIRES_DAYS=7
